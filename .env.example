# Foodics environment: "sandbox" or "production"
FOODICS_ENV=sandbox

# From the app Foodics created for you (support@foodics.com sends these)
FOODICS_CLIENT_ID=
FOODICS_CLIENT_SECRET=

# Must match exactly the redirect URL registered on your Foodics app
FOODICS_REDIRECT_URI=http://localhost:3000/oauth/callback

# Foodics does not sign webhooks, so put a long random value here and register
# the webhook URL as https://<your-public-host>/webhooks/foodics/<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-string

PORT=3000
